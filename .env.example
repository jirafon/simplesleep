# Flow Payment Gateway Configuration
# Obtén estas credenciales desde tu cuenta de Flow: https://www.flow.cl

# API Keys de Flow (sandbox para desarrollo, producción para deploy)
FLOW_API_KEY=your_flow_api_key_here
FLOW_SECRET_KEY=your_flow_secret_key_here

# URL base de Flow (se configurará automáticamente según NODE_ENV)
# Sandbox: https://sandbox.flow.cl/api
# Producción: https://www.flow.cl/api
FLOW_BASE_URL=https://sandbox.flow.cl/api

# URLs de tu aplicación
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# MongoDB
MONGODB_URI=your_mongodb_connection_string

# JWT
JWT_SECRET=your_jwt_secret_here

# AWS S3 (para PDFs)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@siempresalud.cl

# Environment
NODE_ENV=development

# —— SiempreSleep feature flags (server) ——
# Clinical / commerce OFF by default
FF_CLINICAL_ORDERS=false
FF_DOCTOR_PORTAL=false
FF_COMMERCE=false
FF_CYCLE_MENOPAUSE=false
FF_EXPERIMENTAL_ECG=false
FF_EXPERIMENTAL_BP=false
FF_MEDICAL_ALERTS=false
FF_RISK_ANALYSIS=false
FF_SPORTS_TRACKING=false
FF_OPTIONAL_LOCATION=true
FF_HELP_BUTTON=true
FF_LEGACY_PANIC_ALIAS=true
FF_SLEEP_MVP=true
FF_SLEEP_EXPERIMENTS=true
FF_SLEEP_INSIGHTS_ENGINE=true
REACT_APP_FF_SLEEP_MVP=true
REACT_APP_FF_SLEEP_EXPERIMENTS=true
REACT_APP_FF_SLEEP_INSIGHTS_ENGINE=true
