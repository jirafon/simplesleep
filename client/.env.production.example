# Production environment variables
# Frontend Render deploys need an explicit backend URL.
REACT_APP_BASE_URL=https://siempresalud-server.onrender.com

# AWS values must be provided through the deploy platform, not committed.
REACT_APP_ACCESS_KEY_ID=your_access_key_id_here
REACT_APP_SECRET_ACCESS_KEY=your_secret_access_key_here
REACT_APP_BUCKET=your_bucket_name_here